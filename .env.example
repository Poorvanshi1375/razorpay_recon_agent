# Google Gemini API Key (Free Tier from https://ai.google.dev/)
# Required for Tier 3 exception classification and Phase 5 adversarial verifier
GEMINI_API_KEY=your_free_tier_gemini_api_key_here

# Optional: Razorpay API Credentials
# Only needed if re-fetching live payment samples from Razorpay API to rebuild real_samples/ from scratch.
# Not required for normal pipeline execution, test suite, or evaluation runs.
# RAZORPAY_KEY_ID=your_razorpay_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
